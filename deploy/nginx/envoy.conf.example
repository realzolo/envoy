upstream envoy_web {
    server 127.0.0.1:6178;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name envoy.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name envoy.example.com;

    ssl_certificate /etc/letsencrypt/live/envoy.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/envoy.example.com/privkey.pem;

    client_max_body_size 32m;
    server_tokens off;

    location / {
        proxy_pass http://envoy_web;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
