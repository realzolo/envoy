NODE_ENV=production
PORT=6178

DATABASE_URL=postgresql://envoy:replace_with_password@postgres.example.internal:5432/envoy?sslmode=require
DATABASE_POOL_SIZE=10
REDIS_URL=redis://default:replace_with_url_encoded_password@redis.example.internal:6379/0

# Root trust for envelope encryption. Back this value up separately.
ENVOY_KEK_BASE64=replace_with_a_base64_encoded_32_byte_key
ENVOY_KEK_VERSION=kek-1
# ENVOY_KEK_KEYRING_JSON={"kek-previous":"base64_encoded_32_byte_key"}

ENVOY_ADMIN_EMAIL=admin@example.com
ENVOY_ADMIN_PASSWORD=replace_with_a_strong_password
ENVOY_SESSION_SECRET=replace_with_at_least_32_random_characters

OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_PREFIX=envoy
OBJECT_STORAGE_BUCKET=replace_with_bucket
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=https://replace_with_account_id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=replace_with_r2_access_key
AWS_SECRET_ACCESS_KEY=replace_with_r2_secret_key

# Required when inbound mail or attachments are enabled. The address must be reachable from the Worker container.
CLAMAV_HOST=replace_with_clamav_host
CLAMAV_PORT=3310

DELIVERY_CONCURRENCY=10
EVENT_CONCURRENCY=10
CALLBACK_CONCURRENCY=5
RECONCILIATION_CONCURRENCY=3
ENVOY_CIRCUIT_FAILURE_THRESHOLD=5
ENVOY_CIRCUIT_OPEN_SECONDS=300
