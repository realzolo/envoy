# Shared configuration reference; never put real credentials in this file.
# Local: copy to .env.local. Docker production: copy to .env.production.
# Next.js and the Docker image set NODE_ENV automatically.
TZ=UTC
PORT=6178

# Local development default. In Docker, use a host reachable from the container,
# e.g. postgresql://envoy:replace_with_password@postgres.example.internal:5432/envoy?sslmode=require
DATABASE_URL=postgresql://envoy:envoy@localhost:5432/envoy
DATABASE_POOL_SIZE=10
# Per BullMQ backend; each worker also holds a dedicated LISTEN connection.
QUEUE_POOL_SIZE=2

# Root trust for envelope encryption. Must decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32. Back this value up separately.
ENVOY_KEK_BASE64=replace_with_a_base64_encoded_32_byte_key
ENVOY_KEK_VERSION=kek-1
# Keep prior KEKs available by version while old envelopes are being rewrapped.
# ENVOY_KEK_KEYRING_JSON={"kek-previous":"base64_encoded_32_byte_key"}

# Admin console authentication.
ENVOY_ADMIN_EMAIL=replace_with_admin_email
ENVOY_ADMIN_PASSWORD=replace_with_a_strong_password
# Generate with: openssl rand -hex 32.
ENVOY_SESSION_SECRET=replace_with_at_least_32_random_characters

# Set only when a trusted reverse proxy overwrites client-supplied X-Forwarded-* headers
# and the Envoy port is not directly reachable by untrusted clients.
# ENVOY_TRUST_PROXY=true

# Default callback destinations must be public HTTPS addresses. Set only when Envoy is
# permitted to call private network services; HTTP is then allowed only for those services.
# ENVOY_ALLOW_PRIVATE_CALLBACKS=true

# Object storage. Local is for development only; the production container exits
# before startup unless this is s3 with a bucket and region. Web and Worker do
# not share local files. A custom S3 endpoint also requires its own key pair.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_PREFIX=envoy
# OBJECT_STORAGE_BUCKET=envoy-production
# OBJECT_STORAGE_REGION=us-east-1
# For R2, use region=auto and the account endpoint below; leave SSE unset.
# OBJECT_STORAGE_ENDPOINT=https://replace_with_account_id.r2.cloudflarestorage.com
# R2 credentials are independent from AWS runtime credentials used by SES.
# OBJECT_STORE_ACCESS_KEY_ID=replace_with_object_store_access_key
# OBJECT_STORE_SECRET_ACCESS_KEY=replace_with_object_store_secret_key

# Attachment scanning is optional. require_clean is the default and blocks use when no scanner is available.
# Set ATTACHMENT_SCAN_MODE=integrity_only explicitly to permit files after size/hash verification without malware scanning.
# Apply the same mode to Web and Worker; switching to require_clean later invalidates integrity-only proofs and rescans files.
# ATTACHMENT_SCAN_MODE=require_clean
# In Docker, replace 127.0.0.1 with a scanner host reachable from the worker container.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=15000
# ATTACHMENT_SCAN_CONCURRENCY=4
# ATTACHMENT_POLICY_VERSION=1

DELIVERY_CONCURRENCY=10
EVENT_CONCURRENCY=10
CALLBACK_CONCURRENCY=5
RECONCILIATION_CONCURRENCY=3
ENVOY_CIRCUIT_FAILURE_THRESHOLD=5
ENVOY_CIRCUIT_OPEN_SECONDS=300

# Content retention is disabled until a policy is set. Choose days for your business.
# data:cleanup defaults to dry-run; pass --apply to delete eligible content.
ENVOY_RETENTION_BATCH_SIZE=100
# ENVOY_RETENTION_CONTENT_DAYS=30
# ENVOY_RETENTION_RAW_DAYS=30
# ENVOY_RETENTION_INBOUND_DAYS=30
# ENVOY_RETENTION_CALLBACK_DAYS=30
# ENVOY_RETENTION_REQUEST_LOG_DAYS=30
# ENVOY_RETENTION_AUDIT_DETAILS_DAYS=365
