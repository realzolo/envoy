# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/
/var/

# Server-owned Compose configuration at the repository root
/docker-compose.yml

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Runtime env files stay local; only the shared configuration example is committed.
.env*
!.env.example

# editors
.idea/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
