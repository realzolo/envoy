{
  "name": "envoy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 6178",
    "dev:all": "concurrently -k -n web,worker -c blue,green \"next dev -p 6178\" \"tsx watch src/worker/index.ts\"",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "build": "next build",
    "start": "next start -p 6178",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:setup": "pnpm db:migrate",
    "data:cleanup": "tsx scripts/retention.ts",
    "db:generate": "tsx db/baseline.ts --write",
    "db:check": "tsx db/baseline.ts",
    "architecture:check": "tsx scripts/check-architecture.ts",
    "test:unit": "vitest run --config vitest.unit.config.mts"
  },
  "dependencies": {
    "@arco-design/web-react": "2.66.16",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "@aws-sdk/credential-providers": "^3.1152.0",
    "@next/env": "16.4.2",
    "bullmq": "^6.3.15",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "mailparser": "^3.9.28",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.28.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "svix": "^2.5.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "aws-sdk-client-mock": "^4.1.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^6",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.33.0"
}
